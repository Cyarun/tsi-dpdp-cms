{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "record_retention_hold — vAIb-8eem data-subject retention floor on reset/decommission",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "fiduciary_id": {
      "type": "string"
    },
    "floor_days": {
      "type": "integer",
      "minimum": 15
    },
    "trigger": {
      "type": "string",
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "_func",
    "fiduciary_id"
  ]
}
