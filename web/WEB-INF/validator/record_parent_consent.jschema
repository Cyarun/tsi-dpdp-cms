{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "verifier_otp": {
      "type": "string",
      "description": "Fabric->CMS shared-secret proof that the guardian's real OTP/email-link was verified by the gateway (DPDP S9). Constant-time checked server-side; never the guardian's raw code."
    },
    "child_principal_id": {
      "type": "string"
    },
    "guardian_principal_id": {
      "type": "string"
    },
    "verification_mechanism": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "verification_ref_id": {
      "type": "string"
    },
    "proof_metadata": {
      "type": "object"
    }
  },
  "required": [
    "_func",
    "verifier_otp",
    "child_principal_id",
    "guardian_principal_id",
    "verification_mechanism",
    "provider_name",
    "verification_ref_id",
    "proof_metadata"
  ]
}